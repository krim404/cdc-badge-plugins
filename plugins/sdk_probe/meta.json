{
  "id": "sdk_probe",
  "version": "0.1.0",
  "author": "krim",
  "icon": "info",
  "host_api_level_min": "0.8",
  "linear_memory_kb": 128,
  "i18n": {
    "default_language": "en",
    "meta": {
      "name": {
        "en": "SDK Probe"
      },
      "description": {
        "en": "Serial diagnostic that exercises every SDK binding once."
      }
    },
    "strings": {
      "running": {
        "en": "SDK probe running..."
      },
      "done": {
        "en": "SDK probe done"
      }
    }
  },
  "capabilities": {
    "wifi": true,
    "ble": true,
    "http": true,
    "socket": true,
    "display_lowlevel": true,
    "sao": true,
    "pixel_strip": true,
    "usb_cdc": true,
    "vfat": true,
    "nvs_namespace": "plg_sdk_probe",
    "rmem": [
      "probe"
    ],
    "ecc": [
      "probe"
    ],
    "gpio_pins": [
      15,
      16
    ],
    "pwm_pins": [
      15
    ],
    "adc_pins": [
      4
    ],
    "i2c_bus": [
      1
    ],
    "vcard": true,
    "provides": [
      "probe_echo"
    ]
  },
  "prerequisites": {}
}
